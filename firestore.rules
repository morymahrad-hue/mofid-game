rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    match /students/{studentId} {
      allow read, write: if isValidId(studentId);
    }

    match /questions/{questionId} {
      allow read, write: if isValidId(questionId);
    }

    match /quizResults/{resultId} {
      allow read, write: if isValidId(resultId);
    }

    match /botConfig/{configId} {
      allow read, write: if isValidId(configId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
